// Prisma schema for Relocato
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Uploaded image, stored in the database so it persists on any host without
/// external object storage. Served via GET /api/media/[id].
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

/// One editable location-services page (e.g. /services/noida). Every section of
/// that page is stored here so the admin panel can change it without code edits.
model Location {
  id        String  @id @default(cuid())
  slug      String  @unique
  city      String
  state     String
  published Boolean @default(true)
  order     Int     @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Hero section
  heroBadge           String
  heroTitle           String
  heroDescription     String
  heroPrimaryCtaLabel String  @default("Get a Free Quote")
  heroPrimaryCtaHref  String  @default("#contact")
  heroPhone           String? // falls back to SITE_CONFIG.phone
  heroImageUrl        String? // null -> generated CityIllustration SVG

  // Services grid section header
  servicesEyebrow     String
  servicesTitle       String
  servicesDescription String

  // "Areas We Cover" section
  areasTitle       String
  areasDescription String
  areas            String[]

  // "Why Choose Us" section
  whyTitle     String
  whyHighlight String?

  // Quote section copy
  quoteBadge       String
  quoteHeading     String
  quoteDescription String

  services LocationService[]
  features LocationFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model LocationService {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  icon        String? // lucide-react icon name, resolved via src/lib/icons.ts
  imageUrl    String?
  title       String
  description String
  features    String[]

  @@index([locationId, order])
}

/// A group of services shown as one entry in the header "Services" dropdown and
/// as one section on /services (e.g. "Corporate Services").
model ServiceCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  published   Boolean @default(true)
  order       Int     @default(0)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Service {
  id          String          @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order       Int             @default(0)
  icon        String? // lucide-react icon name, resolved via src/lib/icons.ts
  imageUrl    String?
  title       String
  description String
  features    String[]

  @@index([categoryId, order])
}

model LocationFeature {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  icon        String?
  title       String
  description String

  @@index([locationId, order])
}

/// One blog article, shown on /blog and at /blog/<slug>. Written in the admin
/// panel; `content` is Markdown.
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String
  content       String
  coverImageUrl String?
  category      String?
  author        String?
  published     Boolean   @default(false)
  publishedAt   DateTime?

  // SEO
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

/// One page under the header "About Us" dropdown (/about/<slug>), e.g. "Our
/// Story" or "Careers". Every section is optional and is hidden on the site
/// when left empty. The Json columns hold small ordered lists whose shape is
/// enforced by src/lib/schemas/aboutPage.ts.
model AboutPage {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  published Boolean @default(false)
  order     Int     @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Hero
  heroDescription String?
  heroImageUrl    String?

  // Intro: text beside an image
  introEyebrow  String?
  introHeading  String?
  introBody     String?
  introImageUrl String?

  /// Free-form Markdown shown after the intro.
  content String?

  // History timeline: [{ year, title, description, imageUrl }]
  timelineTitle String?
  timeline      Json    @default("[]")

  // Values, vision and mission: values = [{ title, description }]
  valuesTitle String?
  values      Json    @default("[]")
  vision      String?
  mission     String?

  // Numbers: [{ value, label }]
  statsTitle String?
  stats      Json    @default("[]")

  // Accreditation / partner logos: [{ name, imageUrl }]
  logosTitle String?
  logos      Json    @default("[]")

  showTestimonials Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/// One submission of the website quote/contact form, listed at /admin/inquiries.
model Inquiry {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String
  country    String
  movingFrom String?
  movingTo   String?
  message    String?
  /// Page the form was submitted from, e.g. /services/noida.
  sourcePath String?
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}
